							}
						],
						[
							{
								"text": "J/m²",
								"bold": true
							},
							{
								"text": "：一定時間に受けたエネルギーの合計。簡単に言うと、積み重なった光エネルギーです。"
							}
						]
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "大きく分けると、「現在の状態」と「積み重ねた量」の2組として考えることができます。"
						}
					]
				},
				{
					"type": "list",
					"ordered": false,
					"items": [
						[
							{
								"text": "PPFD",
								"bold": true
							},
							{
								"text": "（現在の状態）と "
							},
							{
								"text": "DLI",
								"bold": true
							},
							{
								"text": "（積み重ねた量）"
							}
						],
						[
							{
								"text": "W/m²",
								"bold": true
							},
							{
								"text": "（現在の状態）と "
							},
							{
								"text": "J/m²",
								"bold": true
							},
							{
								"text": "（積み重ねた量）"
							}
						]
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "PPFDとDLIは、特に"
						},
						{
							"text": "植物の光合成や生育を考えるときに使いやすい指標",
							"bold": true
						},
						{
							"text": "です。一方、W/m²やJ/m²は、植物に限らず「光が持っているエネルギー」を測るための指標です。"
						}
					]
				}
			]
		},
		{
			"id": "ppfd",
			"heading": "PPFDとは？",
			"body": [
				{
					"type": "paragraph",
					"content": [
						{
							"text": "PPFD",
							"bold": true
						},
						{
							"text": "は、"
						},
						{
							"text": "Photosynthetic Photon Flux Density",
							"bold": true
						},
						{
							"text": " の略で、日本語では一般的に"
						},
						{
							"text": "光合成光量子束密度",
							"bold": true
						},
						{
							"text": "と呼ばれます。名前だけを見ると非常に難しそうですが、考え方はそれほど複雑ではありません。"
						}
					]
				},
				{
					"type": "note",
					"content": [
						{
							"text": "PPFDは、植物が光合成に利用できる光が、今どれくらい届いているかを表す値です。",
							"bold": true
						}
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "一般的には、"
						},
						{
							"text": "µmol/m²/s",
							"bold": true
						},
						{
							"text": " という単位で表示されます。この単位の詳しい仕組みを覚える必要はありません。農業で利用する場合は、次のように考えれば十分です。"
						}
					]
				},
				{
					"type": "note",
					"content": [
						{
							"text": "PPFDの値が大きいほど、その瞬間に植物へ届いている光合成に利用できる光が多い",
							"bold": true
						}
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "車のスピードメーターで考える。",
							"bold": true
						},
						{
							"text": "PPFDは、車の"
						},
						{
							"text": "スピードメーター",
							"bold": true
						},
						{
							"text": "に似ています。スピードメーターを見れば、「今、時速何kmで走っているか」がわかります。同じようにPPFDを見ることで、「今、植物にどれくらいの光が届いているか」を確認できます。"
						}
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "PPFDは1日の中でも大きく変化する。",
							"bold": true
						},
						{
							"text": "例えば、ハウス内でPPFDを測定すると、次のように変化します。"
						}
					]
				},
				{
					"type": "list",
					"ordered": false,
					"items": [
						[
							{
								"text": "7:00",
								"bold": true
							},
							{
								"text": "：100 µmol/m²/s"
							}
						],
						[
							{
								"text": "9:00",
								"bold": true
							},
							{
								"text": "：450 µmol/m²/s"
							}
						],
						[
							{
								"text": "12:00",
								"bold": true
							},
							{
								"text": "：1,100 µmol/m²/s"
							}
						],
						[
							{
								"text": "15:00",
								"bold": true
							},
							{
								"text": "：700 µmol/m²/s"
							}
						],
						[
							{
								"text": "18:00",
								"bold": true
							},
							{
								"text": "：80 µmol/m²/s"
							}
						]
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "朝は低く、太陽が高くなるにつれて上昇し、夕方になると再び低下します。雲が通過した場合にもPPFDは大きく変化します。そのためPPFDは、例えば次のような確認に向いています。"
						}
					]
				},
				{
					"type": "list",
					"ordered": false,
					"items": [
						[
							{
								"text": "今、作物にどれくらい光が届いているか"
							}
						],
						[
							{
								"text": "ハウス内で光の当たり方に違いがあるか"
							}
						],
						[
							{
								"text": "建物や設備による影が発生していないか"
							}
						],
						[
							{
								"text": "遮光カーテンによって光がどれくらい減っているか"
							}
						],
						[
							{
								"text": "植物育成用LEDからどれくらい光が届いているか"
							}
						],
						[
							{
								"text": "葉の上部と下部で光量にどれくらい差があるか"
							}
						]
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "つまりPPFDは、次のような指標と考えるとわかりやすいでしょう。"
						}
					]
				},
				{
					"type": "note",
					"content": [
						{
							"text": "「今の光環境」を確認するための指標",
							"bold": true
						}
					]
				}
			]
		},
		{
			"id": "dli",
			"heading": "DLIとは？",
			"body": [
				{
					"type": "paragraph",
					"content": [
						{
							"text": "DLI",
							"bold": true
						},
						{
							"text": "は、"
						},
						{
							"text": "Daily Light Integral",
							"bold": true
						},
						{
							"text": " の略で、日本語では"
						},
						{
							"text": "日積算光量",
							"bold": true
						},
						{
							"text": "などと呼ばれます。DLIが教えてくれるのは、次の情報です。"
						}
					]
				},
				{
					"type": "note",
					"content": [
						{
							"text": "植物が1日を通して、合計でどれくらい光を受けたか",
							"bold": true
						}
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "一般的には、"
						},
						{
							"text": "mol/m²/day",
							"bold": true
						},
						{
							"text": " という単位で表示されます。難しく考える必要はなく、次のように考えるとわかりやすくなります。"
						}
					]
				},
				{
					"type": "note",
					"content": [
						{
							"text": "「今日、植物が受けた光の合計」",
							"bold": true
						}
					]
				}
			]
		},
		{
			"id": "ppfd-vs-dli",
			"heading": "PPFDとDLIの違い",
			"body": [
				{
					"type": "paragraph",
					"content": [
						{
							"text": "PPFDとDLIは、どちらか一方を選ぶものではありません。それぞれ違うことを教えてくれます。"
						}
					]
				},
				{
					"type": "list",
					"ordered": false,
					"items": [
						[
							{
								"text": "PPFD",
								"bold": true
							},
							{
								"text": "：今、どれくらい光が届いているか"
							}
						],
						[
							{
								"text": "DLI",
								"bold": true
							},
							{
								"text": "：今日1日で、合計どれくらい光が届いたか"
							}
						]
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "例えば、車で考えてみましょう。PPFDが"
						},
						{
							"text": "スピードメーター",
							"bold": true
						},
						{
							"text": "だとすると、DLIは"
						},
						{
							"text": "今日走った距離",
							"bold": true
						},
						{
							"text": "のようなものです。車の速度は走っている間ずっと変化します。しかし、1日の最後には「今日は合計100km走った」という結果が残ります。"
						}
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "植物の光も同じです。PPFDは常に変化しますが、それを1日分積み重ねたものがDLIです。"
						}
					]
				}
			]
		},
		{
			"id": "why-dli-matters",
			"heading": "なぜDLIが農業で重要なのか",
			"body": [
				{
					"type": "paragraph",
					"content": [
						{
							"text": "例えば、次の2日間を考えてみましょう。"
						}
					]
				},
				{
					"type": "list",
					"ordered": false,
					"items": [
						[
							{
								"text": "1日目",
								"bold": true
							},
							{
								"text": "：午前中は非常によく晴れていました。しかし午後から曇りになりました。"
							}
						],
						[
							{
								"text": "2日目",
								"bold": true
							},
							{
								"text": "：1日目ほど強い日差しではありませんでしたが、朝から夕方まで晴れが続きました。"
							}
						]
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "一番明るかった瞬間だけを比較すると、1日目のほうが良い条件に見えるかもしれません。しかし実際には、2日目のほうが植物が受けた"
						},
						{
							"text": "1日の総光量が多い",
							"bold": true
						},
						{
							"text": "ことがあります。例えば、次のような場合です。"
						}
					]
				},
				{
					"type": "list",
					"ordered": false,
					"items": [
						[
							{
								"text": "月曜日",
								"bold": true
							},
							{
								"text": "：最大PPFD 1,400 µmol/m²/s、DLI 15 mol/m²/day"
							}
						],
						[
							{
								"text": "火曜日",
								"bold": true
							},
							{
								"text": "：最大PPFD 1,050 µmol/m²/s、DLI 21 mol/m²/day"
							}
						]
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "月曜日は、瞬間的には非常に強い光がありました。しかし1日を通して見ると、火曜日のほうが植物は多くの光を受けています。この違いを簡単に確認できるのがDLIです。"
						}
					]
				}
			]
		},
		{
			"id": "peak-is-not-enough",
			"heading": "なぜ「一番明るかった値」だけでは不十分なのか",
			"body": [
				{
					"type": "paragraph",
					"content": [
						{
							"text": "作物にとって重要なのは、「今日の最大PPFDはいくつだったか」だけではありません。"
						}
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "例えば正午に非常に強い光があっても、その前後がずっと曇っていれば、1日全体の光量はそれほど多くない場合があります。反対に、強烈な日差しがなくても、適度な明るさが長時間続けば、十分な光量になる場合があります。"
						}
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "そのため作物管理では、"
						},
						{
							"text": "瞬間的な光量を見るPPFD",
							"bold": true
						},
						{
							"text": "と、"
						},
						{
							"text": "1日全体を見るDLI",
							"bold": true
						},
						{
							"text": "を組み合わせることで、光環境をより理解しやすくなります。"
						}
					]
				}
			]
		},
		{
			"id": "watts",
			"heading": "W/m²とは？",
			"body": [
				{
					"type": "paragraph",
					"content": [
						{
							"text": "光を測る方法として、"
						},
						{
							"text": "W/m²（ワット毎平方メートル）",
							"bold": true
						},
						{
							"text": "という単位もよく使われます。これは、次のことを表しています。"
						}
					]
				},
				{
					"type": "note",
					"content": [
						{
							"text": "1平方メートルあたりに、今どれくらいの光エネルギーが届いているか",
							"bold": true
						}
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "例えば、地表に届く強い太陽光は、条件によっては"
						},
						{
							"text": "約1,000 W/m²",
							"bold": true
						},
						{
							"text": "程度になることがあります。W/m²は、気象観測や太陽光発電などでもよく使われる単位です。"
						}
					]
				}
			]
		},
		{
			"id": "milliwatts",
			"heading": "mW/m²とは？",
			"body": [
				{
					"type": "paragraph",
					"content": [
						{
							"text": "mW/m²",
							"bold": true
						},
						{
							"text": "も基本的にはW/m²と同じ種類の測定値です。mWの「m」は"
						},
						{
							"text": "ミリ",
							"bold": true
						},
						{
							"text": "を意味します。"
						},
						{
							"text": "1 W = 1,000 mW",
							"bold": true
						},
						{
							"text": " です。つまり、"
						},
						{
							"text": "1 W/m² = 1,000 mW/m²",
							"bold": true
						},
						{
							"text": " となります。"
						}
					]
				},
				{
					"type": "paragraph",
					"content": [
						{
							"text": "測定対象の光が弱い場合などに、mW/m²が使われることがあります。"
						}
					]
				}
			]
		},
		{
			"id": "watts-and-plants",
			"heading": "なぜ植物ではW/m²だけでは十分ではないのか",
			"body": [
				{
					"type": "paragraph",
					"content": [
						{
							"text": "ここが重要なポイントです。W/m²は、"
						},
						{
							"text": "光が持っているエネルギー",
							"bold": true
						},
						{
