				}
			]
		},
		{
			"id": "comparison",
			"heading": "まずは簡単に比較",
			"body": [
				{
					"type": "list",
					"ordered": false,
					"items": [
						[
							{
								"text": "PPFD",
								"bold": true
							},
							{
								"text": "：今、植物が受けている光の量。簡単に言うと、現在の「植物にとっての明るさ」です。"
							}
						],
						[
							{
								"text": "DLI",
								"bold": true
							},
							{
								"text": "：1日で植物が受けた光の合計。簡単に言うと、今日1日の「光の総量」です。"
							}
						],
						[
							{
								"text": "W/m²",
								"bold": true
							},
							{
								"text": "：今、届いている光エネルギー。簡単に言うと、現在の日射エネルギーです。"
							}
						],
						[
							{
